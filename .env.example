# Copy these values into Render Environment Variables.
# Do NOT upload a real .env file with actual secrets.

N8N_HOST=your-render-service-name.onrender.com
N8N_PORT=5678
PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://your-render-service-name.onrender.com/
GENERIC_TIMEZONE=Asia/Singapore
TZ=Asia/Singapore
N8N_PROXY_HOPS=1

# Important: create a long random private key.
# Do not change this after you start saving credentials in n8n.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-secret-key

# Optional login protection:
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=replace-with-strong-password
